# Gerado por `tools arch-check --d2` a partir dos imports. Não editar à mão.
direction: right
vars: { d2-config: { layout-engine: elk } }

composition: "composition  (polovoxel)" {
  style: { fill: "#e8effc"; stroke: "#2357c6"; border-radius: 8 }
  "polovoxel/__init__.py": "__init__.py"
  "polovoxel/keymaps.py": "keymaps.py"
  "usecases": "usecases/" { style: { fill: "#ffffff"; stroke: "#2357c6"; stroke-dash: 2 }
    "polovoxel/usecases/factory.py": "factory.py"
  }
}

domain: "domain  (polovoxel/domain)" {
  style: { fill: "#e3f4ec"; stroke: "#1d7a55"; border-radius: 8 }
  "polovoxel/domain/__init__.py": "__init__.py"
  "polovoxel/domain/geometry.py": "geometry.py"
  "polovoxel/domain/mesh_repository.py": "mesh_repository.py"
}

usecases: "usecases  (polovoxel/usecases)" {
  style: { fill: "#fdf1e4"; stroke: "#b4610e"; border-radius: 8 }
  "polovoxel/usecases/__init__.py": "__init__.py"
  "polovoxel/usecases/add_cuboid.py": "add_cuboid.py"
  "polovoxel/usecases/add_first_voxel.py": "add_first_voxel.py"
  "polovoxel/usecases/add_voxel_on_click.py": "add_voxel_on_click.py"
  "polovoxel/usecases/add_voxel_on_face.py": "add_voxel_on_face.py"
}

infra: "infra  (polovoxel/infrastructure)" {
  style: { fill: "#f1eafb"; stroke: "#7140b8"; border-radius: 8 }
  "polovoxel/infrastructure/__init__.py": "__init__.py"
  "polovoxel/infrastructure/blender_mesh.py": "blender_mesh.py"
}

operators: "operators  (polovoxel/operators)" {
  style: { fill: "#e6f5f7"; stroke: "#13758a"; border-radius: 8 }
  "polovoxel/operators/__init__.py": "__init__.py"
  "polovoxel/operators/add_cuboid.py": "add_cuboid.py"
  "polovoxel/operators/add_first_voxel.py": "add_first_voxel.py"
  "polovoxel/operators/add_voxel_on_click.py": "add_voxel_on_click.py"
  "polovoxel/operators/add_voxel_on_face.py": "add_voxel_on_face.py"
}

ui: "ui  (polovoxel/ui)" {
  style: { fill: "#f7efe0"; stroke: "#8a6413"; border-radius: 8 }
  "polovoxel/ui/__init__.py": "__init__.py"
  "polovoxel/ui/panel.py": "panel.py"
  "polovoxel/ui/properties.py": "properties.py"
}

